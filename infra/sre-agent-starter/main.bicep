targetScope = 'resourceGroup'

@minLength(2)
@maxLength(32)
param agentName string

param location string

@description('Existing resource group names in the deployment subscription. Not subscription-wide access.')
@minLength(1)
param targetResourceGroupNames string[]

@description('Unique ownership token generated by the deployment wrapper; retain its manifest.')
@minLength(36)
@maxLength(36)
param ownershipToken string

@description('Explicit opt-in: Reader for the new user-assigned identity at each exact target RG only.')
param grantTargetReader bool = false

@description('Optional approved Entra USER object IDs. No deployer/current-user fallback. Each receives Reader and SRE Agent Administrator on this new agent only.')
param agentAccessUserObjectIds string[] = []

var ownershipTags = {
  component: 'sre-agent-starter'
  ownershipToken: ownershipToken
}

resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2024-11-30' = {
  name: '${agentName}-identity'
  location: location
  tags: ownershipTags
}

resource workspace 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: '${agentName}-logs'
  location: location
  tags: ownershipTags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource insights 'Microsoft.Insights/components@2020-02-02' = {
  name: '${agentName}-insights'
  location: location
  kind: 'web'
  tags: ownershipTags
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: workspace.id
  }
}

resource agent 'Microsoft.App/agents@2026-01-01' = {
  name: agentName
  location: location
  tags: ownershipTags
  identity: {
    type: 'SystemAssigned,UserAssigned'
    userAssignedIdentities: { '${identity.id}': {} }
  }
  properties: {
    actionConfiguration: {
      accessLevel: 'Low'
      mode: 'ReadOnly'
      identity: identity.id
    }
    knowledgeGraphConfiguration: {
      identity: identity.id
      managedResources: [for rg in targetResourceGroupNames: subscriptionResourceId('Microsoft.Resources/resourceGroups', rg)]
    }
    logConfiguration: {
      applicationInsightsConfiguration: {
        appId: insights.properties.AppId
        connectionString: insights.properties.ConnectionString
      }
    }
    upgradeChannel: 'Stable'
  }
}

module targetReader 'target-reader.bicep' = [for rg in targetResourceGroupNames: if (grantTargetReader) {
  scope: resourceGroup(rg)
  params: {
    principalId: identity.properties.principalId
    ownershipToken: ownershipToken
  }
}]

var userRoles = [
  'acdd72a7-3385-48ef-bd42-f606fba81ae7'
  'e79298df-d852-4c6d-84f9-5d13249d1e55'
]
var userGrants = flatten(map(agentAccessUserObjectIds, objectId => map(userRoles, role => {
  objectId: objectId
  role: role
})))

resource userAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = [for grant in userGrants: {
  name: guid(agent.id, grant.objectId, grant.role, ownershipToken)
  scope: agent
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', grant.role)
    principalId: grant.objectId
    principalType: 'User'
    description: 'sre-agent-starter:${ownershipToken}'
  }
}]

output agentId string = agent.id
output userAssignedIdentityId string = identity.id
output userAssignedPrincipalId string = identity.properties.principalId
output systemAssignedPrincipalId string = agent.identity.principalId!
output ownedResourceIds array = [agent.id, insights.id, workspace.id, identity.id]
output ownedTargetRoleAssignmentIds array = [for (rg, i) in targetResourceGroupNames: grantTargetReader ? targetReader[i]!.outputs.roleAssignmentId : '']
output ownedUserRoleAssignmentIds array = [for (grant, i) in userGrants: userAccess[i].id]
output privateNetworkStatus string = 'NOT CONFIGURED: configure Workspace network before private-server use.'
